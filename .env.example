# Copie para ".env" e ajuste antes de rodar "docker compose up".

# Chave de sessão do Flask — gere uma forte, por exemplo:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=bbb2141cb7559f10c6a71fd8ce72cfc64f127efc9410a3bb9f0345b2653a8c89

# Opcional: só defina se quiser controlar a chave de encriptação das senhas
# (banco/FDW) por fora, em vez de usar o arquivo data/.encryption_key gerado
# automaticamente na primeira execução. Se já existe data/.encryption_key
# (ex.: você está migrando uma instalação existente), deixe em branco.
APP_ENCRYPTION_KEY=
